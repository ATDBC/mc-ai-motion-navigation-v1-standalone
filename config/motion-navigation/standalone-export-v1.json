{
  "schema_version": "mc2p.motion-navigation-standalone-export.v1",
  "template_mappings": {
    "packaging/motion-navigation-standalone/.gitattributes": ".gitattributes",
    "packaging/motion-navigation-standalone/README.md": "README.md",
    "packaging/motion-navigation-standalone/AGENTS.md": "AGENTS.md",
    "packaging/motion-navigation-standalone/requirements.txt": "requirements.txt",
    "packaging/motion-navigation-standalone/.gitignore": ".gitignore",
    "packaging/motion-navigation-standalone/LICENSE": "LICENSE"
  },
  "include_globs": [
    "mc2p/**/*.py",
    "mc2p/**/*.java",
    "mc2p/**/*.kt",
    "packaging/motion-navigation-standalone/*",
    "config/motion-navigation/*.json",
    "config/motion-navigation/*.txt",
    "deployment/fabric-observation-probe/build.gradle",
    "deployment/fabric-observation-probe/gradle.properties",
    "deployment/fabric-observation-probe/settings.gradle",
    "deployment/fabric-observation-probe/src/**/*",
    "docs/motion_navigation/architecture/*.md",
    "docs/motion_navigation/stages/*.md",
    "docs/motion_navigation/acceptance/*.md",
    "docs/motion_navigation/decisions/*.md",
    "experiments/navigation-floating-wall-mazes-v1/layouts/maze_03_floating.json",
    "scripts/fixtures/**/*",
    "tests/java/*.java",
    "tools/navigation_layer_live/**/*",
    "tools/navigation_replay/**/*"
  ],
  "python_entry_globs": [
    "scripts/export_motion_navigation_standalone.py",
    "scripts/b10_gap_solver_runtime.py",
    "scripts/probe_fabric_deployment_observation.py",
    "scripts/c1_melee_evidence.py",
    "scripts/c1_moving_melee_evidence.py",
    "scripts/c1_external_motion_evidence.py",
    "scripts/c1_fixed_melee_runtime.py",
    "scripts/c1_moving_melee_runtime.py",
    "scripts/c1_external_motion_runtime.py",
    "tests/motion_nav/test_*.py",
    "tests/test_c1_melee_evidence.py",
    "tests/test_c1_moving_melee_evidence.py",
    "tests/test_c1_external_motion_evidence.py",
    "tests/test_c1_fixed_melee_runtime.py",
    "tests/test_c1_moving_melee_runtime.py",
    "tests/test_c1_external_motion_runtime.py",
    "tests/test_navigation_motion.py",
    "tests/test_craftground_backend.py",
    "tests/test_craftground_runtime.py",
    "tests/test_visible_equipment_projection.py",
    "tests/test_standalone_java_gates.py"
  ],
  "required_paths": [
    "README.md",
    "AGENTS.md",
    ".gitattributes",
    "requirements.txt",
    "LICENSE",
    "config/motion-navigation/c1-control-capability-v1.json",
    "config/motion-navigation/standalone-export-v1.json",
    "mc2p/motion_nav/navigation_session.py",
    "mc2p/motion_nav/motion_solver.py",
    "mc2p/runtime/player_runtime_v1.py",
    "tests/motion_nav/test_standalone_export.py",
    "tests/test_navigation_motion.py",
    "tests/test_craftground_backend.py",
    "tests/test_craftground_runtime.py",
    "tests/test_visible_equipment_projection.py",
    "tests/test_standalone_java_gates.py",
    "docs/motion_navigation/stages/C1R-runtime-navigation-convergence.md",
    "docs/motion_navigation/acceptance/C1R-runtime-navigation-convergence.md"
  ]
}
