diff --git a/mc2p/motion_nav/support_surfaces.py b/mc2p/motion_nav/support_surfaces.py
index 69042cc..cca8011 100644
--- a/mc2p/motion_nav/support_surfaces.py
+++ b/mc2p/motion_nav/support_surfaces.py
@@ -321,3 +321,57 @@ def query_support_surfaces(
     return SupportSurfaceResult(
         QueryStatus.BLOCKED, (), tuple(sorted(query_dependencies)),
     )
+
+
+def standable_point_in_region(
+    world: WorldView,
+    surface: SupportSurface,
+    region: Aabb,
+    *,
+    body_width: float = 0.6,
+    body_height: float = 1.8,
+    minimum_support_fraction: float = 0.5,
+) -> tuple[float, float, float] | None:
+    """Best standable feet position on ``surface`` inside ``region``.
+
+    The representative ``surface.position`` is a block-level choice.  A goal
+    box may lie anywhere on the surface, so the target is the box centre
+    clamped into the part of the surface that the box covers, checked with
+    the same clearance and support rules as the representative point.
+    """
+    top_y = surface.position[1]
+    if not region.min_y - _EPSILON <= top_y <= region.max_y + _EPSILON:
+        return None
+    low_x = max(region.min_x, surface.region.min_x)
+    high_x = min(region.max_x, surface.region.max_x)
+    low_z = max(region.min_z, surface.region.min_z)
+    high_z = min(region.max_z, surface.region.max_z)
+    if low_x > high_x + _EPSILON or low_z > high_z + _EPSILON:
+        return None
+    centre_x = (region.min_x + region.max_x) / 2.0
+    centre_z = (region.min_z + region.max_z) / 2.0
+    half = body_width / 2.0
+    candidates = (
+        (min(max(centre_x, low_x), high_x), min(max(centre_z, low_z), high_z)),
+        ((low_x + high_x) / 2.0, (low_z + high_z) / 2.0),
+    )
+    for x, z in candidates:
+        body = Aabb(x - half, top_y, z - half, x + half, top_y + body_height, z + half)
+        clearance = sweep(body, (0.0, 0.0, 0.0), world)
+        if clearance.status is not QueryStatus.FEASIBLE:
+            continue
+        support = query_support(body, world)
+        if (support.status is QueryStatus.FEASIBLE
+                and support.support_fraction + _EPSILON >= minimum_support_fraction):
+            return (x, top_y, z)
+    return None
+
+
+def surface_overlaps_region(surface: SupportSurface, region: Aabb) -> bool:
+    """Geometric part of the goal test; standability is checked at resolution."""
+    top_y = surface.position[1]
+    return (
+        region.min_y - _EPSILON <= top_y <= region.max_y + _EPSILON
+        and max(region.min_x, surface.region.min_x) <= min(region.max_x, surface.region.max_x) + _EPSILON
+        and max(region.min_z, surface.region.min_z) <= min(region.max_z, surface.region.max_z) + _EPSILON
+    )
