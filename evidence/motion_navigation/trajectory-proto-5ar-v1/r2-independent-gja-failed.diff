+def _jumps(tier: InputTier) -> tuple[tuple[int, TickInput], ...]:
+    return tuple((index, command) for index, command in enumerate(tier.inputs) if command.jump)
+
+
+def _same_control(*commands: TickInput) -> bool:
+    first = commands[0]
+    return all((command.forward, command.strafe, command.sprint,
+                command.movement_yaw_radians)
+               == (first.forward, first.strafe, first.sprint,
+                   first.movement_yaw_radians)
+               for command in commands[1:])
+
+
+def primitive_prefixes(tier: InputTier) -> Iterator[PrimitivePrefix]:
+    """Enumerate independent G, optional J1 and A identities in stable phases."""
+    gaits = _gaits(tier)
+    jumps = _jumps(tier)
+    for matched_phase in (True, False):
+        for ground_index, ground_input in gaits:
+            for ground_ticks in range(21):
+                ground = (ground_input,) * ground_ticks
+                if matched_phase:
+                    yield PrimitivePrefix(
+                        tier.tier_id, ground_index, None, None,
+                        ground_input.movement_yaw_radians, None, None,
+                        ground_ticks, 0, 0, ground,
+                    )
+                for jump_index, jump_input in jumps:
+                    for air_index, air_input in gaits:
+                        if _same_control(ground_input, jump_input, air_input) is not matched_phase:
+                            continue
+                        for air_ticks in range(17):
+                            yield PrimitivePrefix(
+                                tier.tier_id, ground_index, jump_index, air_index,
+                                ground_input.movement_yaw_radians,
+                                jump_input.movement_yaw_radians,
+                                air_input.movement_yaw_radians,
+                                ground_ticks, air_ticks, 0,
+                                ground + (jump_input,) + (air_input,) * air_ticks,
+                            )
